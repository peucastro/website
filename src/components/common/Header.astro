---
import { Icon } from "astro-icon/components";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const links = [
  { name: "projects", href: "/projects/", icon: "lucide:code-xml" },
  { name: "blog", href: "/blog/", icon: "lucide:text-quote" },
  { name: "about", href: "/about/", icon: "lucide:user" },
  { name: "contact", href: "/contact/", icon: "lucide:send" },
];
---

<header class="bg-bg/80 sticky top-0 z-50 border-b backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href="/"
      class="text-primary hover:text-accent text-xl font-bold transition-colors"
      aria-label="Home"
    >
      pedro
    </a>

    <div class="hidden gap-6 font-mono text-sm md:flex">
      {
        links.map(({ name, href }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-label={name}
              class={`group flex transition-colors ${isActive ? "text-primary" : "text-muted"}`}
            >
              <span class="select-none">[</span>
              <span
                class={`px-0.5 ${isActive ? "text-fg" : "text-fg-muted group-hover:text-fg"}`}
              >
                {name}
              </span>
              <span class="select-none">]</span>
            </a>
          );
        })
      }
    </div>

    <div class="flex gap-4 font-mono text-sm md:hidden">
      {
        links.map(({ name, href, icon }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-label={name}
              class={`flex items-center transition-all ${isActive ? "text-primary" : "text-muted"}`}
            >
              {isActive ? (
                <>
                  <span class="select-none">[</span>
                  <div class="flex items-center px-1">
                    <span class="text-fg">{name}</span>
                  </div>
                  <span class="select-none">]</span>
                </>
              ) : (
                <div class="hover:bg-bg-soft flex h-8 w-8 items-center justify-center rounded-sm transition-colors">
                  <Icon name={icon} class="h-[1.2em] w-[1.2em]" />
                </div>
              )}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>
