---
import IconLink from "@components/ui/IconLink.astro";
import TagBadge from "@components/ui/TagBadge.astro";
import { formatDate, projectStatusMap } from "$lib/utils";
import { type Project } from "$lib/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const statusClass = `rounded border px-2 py-0.5 ${projectStatusMap[project.status]} capitalize`;
---

<article
  class="group border-border bg-bg-soft hover:border-primary/80 hover:bg-surface/50 relative border p-6 transition-all"
>
  <header class="mb-4 flex items-start justify-between gap-4">
    <div>
      <h3
        class="text-fg-strong group-hover:text-primary mb-2 text-lg font-bold transition-colors"
      >
        <a
          href={`/projects/${project.slug}/`}
          class="focus-visible:outline-primary"
        >
          <span class="absolute inset-0 z-0" aria-hidden="true"></span>
          {project.title}
        </a>
      </h3>
      <div class="text-muted flex items-center gap-3 font-mono text-xs">
        <time datetime={project.pubDate.toISOString()}>
          {formatDate(project.pubDate)}
        </time>
        <span class="bg-border h-1 w-1 rounded-full"></span>
        <span class={statusClass}>
          {project.status}
        </span>
      </div>
    </div>

    <div class="text-muted relative z-10 flex gap-1">
      {
        project.repositoryUrl && (
          <IconLink
            href={project.repositoryUrl.toString()}
            label="Source Code"
            name="simple-icons:github"
          />
        )
      }
      {
        project.liveUrl && (
          <IconLink
            href={project.liveUrl.toString()}
            label="Live Demo"
            name="lucide:external-link"
          />
        )
      }
    </div>
  </header>

  <p class="text-fg-muted mb-5 text-sm leading-relaxed">
    {project.description}
  </p>

  <footer class="flex flex-col gap-3">
    <div class="flex flex-wrap gap-2">
      {project.tags.map((tag) => <TagBadge tag={tag} />)}

      {
        project.technologies.map((tech) => (
          <span class="bg-bg-deep text-secondary border-border/50 group-hover:border-secondary/30 border px-2 py-0.5 font-mono text-xs uppercase transition-colors">
            {tech}
          </span>
        ))
      }
    </div>
  </footer>
</article>
