---
import PageHeader from "@components/common/PageHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="about">
  <PageHeader title="about me">
    <p class="text-lg">
      Hey there! I'm <strong>Pedro Castro</strong>, an Informatics and Computing
      Engineering student at the <strong
        >Faculty of Engineering of the University of Porto (FEUP)</strong
      >.
    </p>
  </PageHeader>

  <section class="mb-12 space-y-8">
    <p>
      I enjoy building reliable software and understanding how systems work. I
      care about <strong>clean design</strong>,
      <strong>correctness</strong>, and <strong>maintainable code</strong>. My
      main interests are in software engineering, system design, and backend
      development.
    </p>
    <p>
      Currently, I'm a Project Manager and developer at <a
        href="https://niaefeup.pt"
        target="_blank"
        rel="noopener noreferrer"
        class="decoration-primary/30 hover:decoration-primary underline transition-colors"
        >NIAEFEUP</a
      >, where I help design and build tools and platforms that improve the
      academic life of students.
    </p>
  </section>

  <div class="grid grid-cols-1 gap-6 pt-4 md:grid-cols-2">
    <div>
      <h3 class="text-primary mb-2 font-mono text-sm font-bold uppercase">
        What I'm doing
      </h3>
      <ul class="list-inside list-disc space-y-2 text-sm">
        <li>
          Pursuing my Bachelor's Degree in Informatics and Computing Engineering
          at FEUP
        </li>
        <li>Managing and developing projects at NIAEFEUP</li>
        <li>Contributing to open-source projects</li>
        <li>Refining my <strong>NixOS</strong> dotfiles</li>
      </ul>
    </div>
    <div>
      <h3 class="text-primary mb-2 font-mono text-sm font-bold uppercase">
        Interests
      </h3>
      <ul class="list-inside list-disc space-y-1 text-sm">
        <li>Backend Development</li>
        <li>Infrastructure as Code</li>
      </ul>
    </div>
  </div>
</BaseLayout>
